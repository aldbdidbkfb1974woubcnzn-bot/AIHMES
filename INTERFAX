        if i == 1 then
            MainHandsContainer.Visible = true
            DevInfoText.Visible = true
            ContentText.Visible = false
        else
            MainHandsContainer.Visible = false
            DevInfoText.Visible = false
            ContentText.Visible = true
            ContentText.Text = "هذه القائمة قريباً... ⏳"
        end
